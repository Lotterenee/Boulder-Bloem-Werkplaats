# De Kas: environment-variabelen
# Op Railway wordt DATABASE_URL automatisch gezet (Postgres-plugin).

# App
PORT=3000
NODE_ENV=development

# Database (PostgreSQL). Op Railway automatisch via ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/dekas

# Auth.js v5. Genereer met: openssl rand -base64 32
# Zonder AUTH_SECRET valt de app terug op DATABASE_URL als sleutel
# (werkt voor previews; zet in productie ALTIJD een eigen AUTH_SECRET).
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Gedeeld geheim voor het publieke subsidiescan-endpoint (Fase 6).
# De klantensite stuurt dit mee als X-Subsidiescan-Token header.
SUBSIDIESCAN_TOKEN=

# Seed: productie heeft SEED_DATA=false (gezet door de harness);
# dev- en feature-omgevingen seeden automatisch bij deploy.
# SEED_DATA=false

# Demo-data (nepklanten, projecten, ontwerp, offerte, metingen): draait op
# dev/preview zodat elk scherm gevuld is. Zet SEED_DEMO=false om alleen de
# bibliotheekdata te seeden zonder nepklanten. Productie (SEED_DATA=false)
# krijgt sowieso geen demo-data.
# SEED_DEMO=false
