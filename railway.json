{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "app/**",
      "components/**",
      "lib/**",
      "prisma/**",
      "public/**",
      "package.json",
      "package-lock.json",
      "next.config.ts",
      "tailwind.config.ts",
      "middleware.ts"
    ]
  },
  "deploy": {
    "startCommand": "npx prisma migrate deploy && npx tsx prisma/seed.ts && npm run start",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
